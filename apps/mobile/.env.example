# x-post-fetcher (apps/worker) の公開APIベースURL。
# 実際の値は各自の .env（gitignore対象）に設定すること。ここには実値を書かない。
#
# ローカル開発の例: http://localhost:8787
#   （`cd ../x-post-fetcher/apps/worker && npm run dev` でWorkerを起動して使う）
# 本番/ステージングの例: https://api.example.com
#   （本番URLは別途確定次第、本番ビルド時のENVとして設定する。未設定のまま本番ビルドすると
#     アプリ側が明確にエラーを出す仕様のため、localhostへの暗黙フォールバックはしない）
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# --- RevenueCat課金基盤（Mobile-G4）。未設定の間はlib/purchases.tsが安全にnotConfigured状態
#     のままとなり、アプリの他機能には影響しない ---
#
# RevenueCatダッシュボードのPublic（SDK）API Key。クライアントに埋め込まれる値のため
# EXPO_PUBLIC_* で問題ない（Secret API Keyとは別物。Secret API KeyはWorker側のみで扱い、
# 絶対にこちらへ設定しない）。
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
#
# Product ID（確定値）。App Store Connect・RevenueCat側の設定と完全に一致させること。
# EXPO_PUBLIC_REVENUECAT_MONTHLY_PRODUCT_ID=cardhub_premium_monthly
# EXPO_PUBLIC_REVENUECAT_LIFETIME_PRODUCT_ID=cardhub_premium_lifetime
